# ==============================================================================
# Global & Environment Configuration
# ==============================================================================
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_NAME=EventDrivenOrderPlatform

# ==============================================================================
# Security & JWT Auth
# ==============================================================================
JWT_SECRET_KEY=dev_insecure_jwt_secret_key_change_in_production_32chars!
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ==============================================================================
# Redis (Caching, Rate Limiting, Idempotency Deduplication)
# ==============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0

# ==============================================================================
# RabbitMQ (Message Broker, DLX, Exchanges & Queues)
# ==============================================================================
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# ==============================================================================
# PostgreSQL Databases (Database-per-Service Principle)
# ==============================================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Order Service Database
ORDER_DB_NAME=order_db
ORDER_DB_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/order_db

# Product Service Database
PRODUCT_DB_NAME=product_db
PRODUCT_DB_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/product_db

# Inventory Service Database
INVENTORY_DB_NAME=inventory_db
INVENTORY_DB_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/inventory_db

# Payment Service Database
PAYMENT_DB_NAME=payment_db
PAYMENT_DB_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/payment_db

# ==============================================================================
# MongoDB Databases (Polyglot Persistence: Document Store for Audit & Notifications)
# ==============================================================================
MONGODB_HOST=localhost
MONGODB_PORT=27017
MONGODB_USER=
MONGODB_PASSWORD=
MONGODB_URL=mongodb://localhost:27017
NOTIFICATION_DB_NAME=notification_db
AUDIT_DB_NAME=audit_db

# ==============================================================================
# Service Ports & Networking
# ==============================================================================
GATEWAY_PORT=8000
ORDER_SERVICE_PORT=8001
ORDER_SERVICE_GRPC_PORT=50051
PRODUCT_SERVICE_PORT=8002
PRODUCT_SERVICE_GRPC_PORT=50052
INVENTORY_SERVICE_PORT=8003
INVENTORY_SERVICE_GRPC_PORT=50053
PAYMENT_SERVICE_PORT=8004
PAYMENT_SERVICE_GRPC_PORT=50054
NOTIFICATION_SERVICE_PORT=8005
AUDIT_SERVICE_PORT=8006
